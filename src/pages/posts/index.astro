---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts } from '../../lib/posts';

const posts = await getPublishedPosts();
---

<BaseLayout title="文章" description="Kris 的研究笔记、方法与建站记录。">
  <header class="page-hero page-width">
    <p class="eyebrow">All writing</p>
    <h1>文章</h1>
    <p class="lead">保留问题如何展开、方法如何选择，以及结果如何被理解。</p>
  </header>

  <section class="page-width posts-section" aria-label="全部文章">
    {posts.length > 0 ? posts.map((post, index) => <PostCard post={post} index={index} />) : (
      <div class="empty-state">还没有公开文章。</div>
    )}
  </section>
</BaseLayout>

<style>
  .posts-section {
    padding-bottom: 2rem;
  }
</style>
