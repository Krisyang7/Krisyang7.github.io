---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts } from '../../lib/posts';

const posts = await getPublishedPosts();
---

<BaseLayout title="笔记库" description="搜索和浏览 Kris 的论文阅读、学习记录与思考随记。">
  <header class="page-hero page-width library-hero">
    <p class="eyebrow">Learning archive</p>
    <h1>笔记库</h1>
    <p class="lead">从标题、主题或论文作者出发，重新找到当时的理解与疑问。</p>
  </header>

  <section class="library page-width" aria-labelledby="library-tools-heading">
    <h2 id="library-tools-heading" class="visually-hidden">搜索与筛选笔记</h2>
    <div class="library-tools">
      <label class="search-field" for="note-search">
        <span>搜索笔记</span>
        <input id="note-search" type="search" placeholder="标题、标签、论文或作者" autocomplete="off" />
      </label>

      <fieldset class="type-filter">
        <legend>笔记类型</legend>
        <div class="filter-buttons">
          <button type="button" data-type-filter="all" aria-pressed="true">全部</button>
          <button type="button" data-type-filter="paper" aria-pressed="false">论文</button>
          <button type="button" data-type-filter="learning" aria-pressed="false">学习</button>
          <button type="button" data-type-filter="thought" aria-pressed="false">思考</button>
        </div>
      </fieldset>

      <div class="status-field">
        <label for="status-filter">阅读状态</label>
        <span class="select-wrap">
          <select id="status-filter">
            <option value="all">全部状态</option>
            <option value="reading">阅读中</option>
            <option value="finished">已读</option>
            <option value="revisit">待重读</option>
          </select>
        </span>
      </div>
    </div>

    <div class="library-summary">
      <p id="result-count" aria-live="polite">{posts.length} 条笔记</p>
      <a href="/archive/">按时间回看</a>
    </div>

    <div id="notes-list">
      {posts.map((post, index) => {
        const searchText = [
          post.data.title,
          post.data.description,
          ...post.data.tags,
          post.data.paperTitle,
          ...(post.data.authors ?? []),
          post.data.venue,
        ].filter(Boolean).join(' ').toLocaleLowerCase('zh-CN');

        return (
          <div
            data-note-card
            data-note-type={post.data.noteType}
            data-reading-status={post.data.readingStatus ?? ''}
            data-search={searchText}
          >
            <PostCard post={post} index={index} />
          </div>
        );
      })}
    </div>

    <div id="no-results" class="empty-state" hidden>
      {posts.length === 0
        ? '笔记库还是空的。写下第一篇笔记后，它会出现在这里。'
        : '没有找到匹配的笔记。可以换一个关键词，或清除筛选条件。'}
    </div>
  </section>
</BaseLayout>

<script>
  const searchInput = document.querySelector<HTMLInputElement>('#note-search');
  const statusSelect = document.querySelector<HTMLSelectElement>('#status-filter');
  const typeButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-type-filter]')];
  const noteCards = [...document.querySelectorAll<HTMLElement>('[data-note-card]')];
  const resultCount = document.querySelector<HTMLElement>('#result-count');
  const noResults = document.querySelector<HTMLElement>('#no-results');
  const validTypes = new Set(['paper', 'learning', 'thought']);
  const requestedType = new URLSearchParams(window.location.search).get('type');
  let activeType = requestedType && validTypes.has(requestedType) ? requestedType : 'all';

  const applyFilters = () => {
    const query = searchInput?.value.trim().toLocaleLowerCase('zh-CN') ?? '';
    const status = statusSelect?.value ?? 'all';
    let visibleCount = 0;

    noteCards.forEach((card) => {
      const matchesQuery = !query || card.dataset.search?.includes(query);
      const matchesType = activeType === 'all' || card.dataset.noteType === activeType;
      const matchesStatus = status === 'all' || card.dataset.readingStatus === status;
      const isVisible = Boolean(matchesQuery && matchesType && matchesStatus);
      card.hidden = !isVisible;
      if (isVisible) visibleCount += 1;
    });

    typeButtons.forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.typeFilter === activeType));
    });

    if (resultCount) resultCount.textContent = `${visibleCount} 条笔记`;
    if (noResults) noResults.hidden = visibleCount !== 0;
  };

  searchInput?.addEventListener('input', applyFilters);
  statusSelect?.addEventListener('change', applyFilters);
  typeButtons.forEach((button) => {
    button.addEventListener('click', () => {
      activeType = button.dataset.typeFilter ?? 'all';
      const url = new URL(window.location.href);
      if (activeType === 'all') url.searchParams.delete('type');
      else url.searchParams.set('type', activeType);
      window.history.replaceState({}, '', url);
      applyFilters();
    });
  });

  applyFilters();
</script>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .library-hero {
    padding-bottom: 3rem;
  }

  .library {
    padding-bottom: 2rem;
  }

  .library-tools {
    display: grid;
    grid-template-columns: minmax(16rem, 1fr) auto 11rem;
    gap: 1.5rem;
    align-items: end;
    padding: 1.5rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 0.65rem;
    box-shadow: var(--shadow);
  }

  .search-field,
  .status-field,
  .type-filter {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .search-field > span,
  .status-field > label,
  .type-filter legend {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--muted);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .search-field input,
  .status-field select {
    width: 100%;
    height: 2.8rem;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--line-strong);
    border-radius: 0.4rem;
    font-size: 1rem;
  }

  .search-field input {
    padding: 0 0.85rem;
  }

  .search-field input::placeholder {
    color: var(--faint);
  }

  .select-wrap {
    position: relative;
    display: block;
  }

  .select-wrap::after {
    position: absolute;
    top: 50%;
    right: 0.85rem;
    width: 0.45rem;
    height: 0.45rem;
    border-right: 1.5px solid var(--muted);
    border-bottom: 1.5px solid var(--muted);
    content: '';
    pointer-events: none;
    transform: translateY(-70%) rotate(45deg);
  }

  .status-field select {
    padding: 0 2rem 0 0.75rem;
    appearance: none;
  }

  .filter-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .filter-buttons button {
    min-height: 2.8rem;
    padding: 0.5rem 0.75rem;
    color: var(--muted);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 0.4rem;
    font-size: 0.88rem;
    font-weight: 700;
    cursor: pointer;
  }

  .filter-buttons button:hover,
  .filter-buttons button[aria-pressed='true'] {
    color: var(--accent-strong);
    background: var(--accent-soft);
    border-color: var(--accent);
  }

  .library-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2rem;
    color: var(--faint);
    font-size: 0.86rem;
  }

  .library-summary a {
    color: var(--accent);
    font-weight: 700;
  }

  [data-note-card][hidden] {
    display: none;
  }

  #no-results {
    margin-top: 2rem;
  }

  @media (max-width: 900px) {
    .library-tools {
      grid-template-columns: 1fr 1fr;
    }

    .search-field {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 620px) {
    .library-tools {
      grid-template-columns: 1fr;
      gap: 1.2rem;
      padding: 1rem;
    }

    .search-field {
      grid-column: auto;
    }

    .filter-buttons button {
      flex: 1;
    }
  }
</style>
