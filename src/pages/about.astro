---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config';
---

<BaseLayout title="关于" description="关于 Kris 的个人学习档案。">
  <header class="page-hero page-width about-hero">
    <div>
      <p class="eyebrow">About this archive</p>
      <h1>你好，<br />这里是 Kris 的<br /><span>学习档案。</span></h1>
    </div>
    <p class="lead">
      这个网站用来保存读过的论文、学到的方法和当时的理解。以后忘记时，可以沿着主题和时间重新走回来。
    </p>
  </header>

  <section class="about-body page-width">
    <div class="about-index" aria-hidden="true">
      <span>ARCHIVE / 01</span>
      <i></i>
    </div>
    <div class="about-copy">
      <h2>为什么记录</h2>
      <p>读完一篇论文后，我常常记得“读过”，却忘了当时为什么认同、哪里没有看懂、它又和哪些知识发生了联系。把这些过程写下来，是为了给未来的自己保留一条返回路径。</p>
      <p>这里不追求固定更新，也不把笔记写成标准答案。每篇内容会尽量留下来源、核心理解、仍然存在的疑问，以及下一次值得回看的位置。</p>

      <h2>这里会记录</h2>
      <div class="focus-grid">
        <div>
          <span>01</span>
          <strong>论文阅读</strong>
          <p>论文解决的问题、核心方法和我的理解。</p>
        </div>
        <div>
          <span>02</span>
          <strong>学习记录</strong>
          <p>课程、书籍、代码和新学到的方法。</p>
        </div>
        <div>
          <span>03</span>
          <strong>思考回看</strong>
          <p>尚未想清楚的问题，以及理解如何变化。</p>
        </div>
      </div>

    </div>

    <aside class="contact-card">
      <span>Find me online</span>
      <a href={SITE.github} target="_blank" rel="noreferrer">GitHub / Krisyang7</a>
      <a href="/rss.xml">RSS / Subscribe</a>
    </aside>
  </section>
</BaseLayout>

<style>
  .about-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(18rem, 0.6fr);
    gap: 5rem;
    align-items: end;
  }

  .about-hero h1 span {
    color: var(--accent);
  }

  .about-hero .lead {
    padding-bottom: 0.6rem;
  }

  .about-body {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr) 17rem;
    gap: clamp(2rem, 6vw, 5rem);
    padding-top: 2rem;
  }

  .about-index {
    display: flex;
    align-items: center;
    flex-direction: column;
    color: var(--faint);
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    writing-mode: vertical-rl;
  }

  .about-index i {
    width: 1px;
    height: 7rem;
    margin-top: 0.8rem;
    background: var(--line-strong);
  }

  .about-copy {
    max-width: 45rem;
  }

  .about-copy > h2 {
    margin: 0 0 1rem;
    font-size: 2rem;
    letter-spacing: -0.04em;
  }

  .about-copy > h2:not(:first-child) {
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .about-copy > p {
    color: var(--muted);
    font-size: 1.08rem;
  }

  .focus-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
  }

  .focus-grid > div {
    min-height: 12rem;
    padding: 1rem;
    background: var(--surface);
    border: 1px solid var(--line);
  }

  .focus-grid span {
    display: block;
    margin-bottom: 2.5rem;
    color: var(--faint);
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: 0.72rem;
  }

  .focus-grid strong {
    display: block;
  }

  .focus-grid p {
    margin: 0.45rem 0 0;
    color: var(--muted);
    font-size: 0.84rem;
  }

  .contact-card {
    position: sticky;
    top: 7rem;
    display: grid;
    align-self: start;
    padding: 1.25rem;
    background: var(--surface);
    border: 1px solid var(--line);
  }

  .contact-card span {
    margin-bottom: 1rem;
    color: var(--faint);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .contact-card a {
    padding: 0.7rem 0;
    border-top: 1px solid var(--line);
    font-size: 0.88rem;
    font-weight: 650;
    text-decoration: none;
  }

  .contact-card a:hover {
    color: var(--accent);
  }

  @media (max-width: 950px) {
    .about-hero,
    .about-body {
      grid-template-columns: 1fr;
    }

    .about-hero {
      gap: 2rem;
    }

    .about-index {
      display: none;
    }

    .contact-card {
      position: static;
      max-width: 28rem;
    }
  }

  @media (max-width: 620px) {
    .focus-grid {
      grid-template-columns: 1fr;
    }

    .focus-grid > div {
      min-height: auto;
    }

    .focus-grid span {
      margin-bottom: 1.2rem;
    }
  }
</style>
