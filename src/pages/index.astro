---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { SITE } from '../config';
import { formatDate, getPublishedPosts, getReadingTime, postUrl } from '../lib/posts';

const posts = await getPublishedPosts();
const featured = posts.find((post) => post.data.featured) ?? posts[0];
const latestPosts = posts.slice(0, 4);
const tagCounts = new Map<string, number>();

posts.forEach((post) => {
  post.data.tags.forEach((tag) => tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1));
});

const topTags = [...tagCounts.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'zh-CN'))
  .slice(0, 6);
---

<BaseLayout>
  <section class="home-hero page-width">
    <div class="hero-copy">
      <p class="eyebrow">Research field notes</p>
      <h1>把探索，整理成<br /><span>可以复用的知识。</span></h1>
      <p class="hero-lead">
        这里记录问题、阅读、实验与复盘。保留推理的路径，也分享抵达答案之前的过程。
      </p>
      <div class="button-row">
        <a class="button" href="/posts/">阅读文章</a>
        <a class="button secondary" href="/about/">了解本站</a>
      </div>
      <div class="hero-coordinate" aria-hidden="true">
        <span>STATIC / MARKDOWN</span>
        <span>GITHUB PAGES</span>
        <span>EST. 2026</span>
      </div>
    </div>

    <div class="featured-wrap">
      <div class="featured-grid" aria-hidden="true"></div>
      {featured ? (
        <article class="featured-card">
          <div class="featured-topline">
            <span>最近更新</span>
            <span class="pulse"><i></i> Live note</span>
          </div>
          <div class="featured-body">
            <div class="post-meta">
              <time datetime={featured.data.publishDate.toISOString()}>{formatDate(featured.data.publishDate)}</time>
              <span>{getReadingTime(featured.body)} 分钟阅读</span>
            </div>
            <h2><a href={postUrl(featured)}>{featured.data.title}</a></h2>
            <p>{featured.data.description}</p>
          </div>
          <div class="featured-footer">
            <div class="tag-row">
              {featured.data.tags.slice(0, 3).map((tag) => (
                <a class="tag" href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>
              ))}
            </div>
            {featured.data.isExample && <span class="sample-note">示例文章</span>}
          </div>
        </article>
      ) : (
        <div class="empty-state">第一篇文章正在路上。</div>
      )}
    </div>
  </section>

  <section class="latest page-width" aria-labelledby="latest-heading">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Latest writing</p>
        <h2 id="latest-heading">最近文章</h2>
        <p>按时间整理的研究笔记、方法与建站记录。</p>
      </div>
      <a class="section-link" href="/archive/">查看全部归档</a>
    </div>
    <div>
      {latestPosts.map((post, index) => <PostCard post={post} index={index} />)}
    </div>
  </section>

  <section class="topic-section">
    <div class="page-width topic-grid">
      <div class="topic-intro">
        <p class="eyebrow">Topic index</p>
        <h2>沿着主题，继续探索。</h2>
        <p>主题会随着内容自然生长。现在的条目来自站内示例文章，替换内容后会自动更新。</p>
      </div>
      <div class="topic-list">
        {topTags.map(([tag, count], index) => (
          <a href={`/tags/${encodeURIComponent(tag)}/`}>
            <span class="topic-number">{String(index + 1).padStart(2, '0')}</span>
            <strong>{tag}</strong>
            <span>{count} 篇</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="manifesto page-width">
    <div class="manifesto-label">Notes on the process</div>
    <blockquote>“好的研究记录，不只保存答案，也保存问题是如何被重新定义的。”</blockquote>
    <div class="manifesto-copy">
      <p>这个博客以 Markdown 为内容源，用 Astro 生成纯静态页面，保持阅读体验快速、清晰，也让每一篇笔记都能被 Git 管理。</p>
      <a class="section-link" href={SITE.github} target="_blank" rel="noreferrer">在 GitHub 查看源码</a>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(3rem, 8vw, 7rem);
    align-items: center;
    min-height: calc(100vh - 4.5rem);
    padding-block: 6rem;
  }

  .hero-copy h1 {
    margin: 0;
    font-size: clamp(3rem, 5vw, 5rem);
    line-height: 0.98;
    letter-spacing: -0.075em;
  }

  .hero-copy h1 span {
    color: var(--accent);
  }

  .hero-lead {
    max-width: 32rem;
    margin: 1.6rem 0 0;
    color: var(--muted);
    font-size: clamp(1.05rem, 1.8vw, 1.22rem);
  }

  .hero-coordinate {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 3.5rem;
    color: var(--faint);
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
  }

  .featured-wrap {
    position: relative;
    min-height: 33rem;
    padding: 3.2rem;
  }

  .featured-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 2.5rem 2.5rem;
    border: 1px solid var(--line);
    opacity: 0.75;
  }

  .featured-grid::before,
  .featured-grid::after {
    position: absolute;
    width: 0.65rem;
    height: 0.65rem;
    border: 2px solid var(--accent);
    content: '';
  }

  .featured-grid::before {
    top: -1px;
    left: -1px;
    border-right: 0;
    border-bottom: 0;
  }

  .featured-grid::after {
    right: -1px;
    bottom: -1px;
    border-top: 0;
    border-left: 0;
  }

  .featured-card {
    position: relative;
    display: flex;
    min-height: 26.5rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line-strong);
    box-shadow: var(--shadow);
  }

  .featured-topline,
  .featured-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .featured-topline {
    color: var(--faint);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .pulse {
    display: flex;
    gap: 0.4rem;
    align-items: center;
    color: var(--teal);
  }

  .pulse i {
    width: 0.45rem;
    height: 0.45rem;
    background: currentColor;
    border-radius: 50%;
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--teal) 14%, transparent);
  }

  .featured-body {
    margin-block: auto;
    padding-block: 3rem;
  }

  .featured-body h2 {
    max-width: 29rem;
    margin: 1rem 0;
    font-size: clamp(2rem, 4vw, 3.4rem);
    line-height: 1.12;
    letter-spacing: -0.05em;
  }

  .featured-body h2 a {
    text-decoration: none;
  }

  .featured-body h2 a:hover {
    color: var(--accent);
  }

  .featured-body p {
    max-width: 31rem;
    margin: 0;
    color: var(--muted);
  }

  .featured-footer {
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .featured-footer .tag-row {
    margin: 0;
  }

  .sample-note {
    flex: none;
    color: var(--teal);
    font-size: 0.76rem;
    font-weight: 700;
  }

  .latest {
    padding-block: 6.5rem;
  }

  .topic-section {
    padding-block: 6.5rem;
    background: var(--surface);
    border-block: 1px solid var(--line);
  }

  .topic-grid {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: clamp(3rem, 10vw, 9rem);
  }

  .topic-intro h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.4rem);
    line-height: 1.12;
    letter-spacing: -0.05em;
  }

  .topic-intro > p:last-child {
    color: var(--muted);
  }

  .topic-list {
    border-top: 1px solid var(--line);
  }

  .topic-list a {
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    gap: 1rem;
    align-items: center;
    padding: 1.05rem 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }

  .topic-list a:hover strong {
    color: var(--accent);
  }

  .topic-number,
  .topic-list a > span:last-child {
    color: var(--faint);
    font-size: 0.78rem;
  }

  .topic-number {
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
  }

  .manifesto {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr) minmax(14rem, 0.45fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
    padding-block: 7rem 1rem;
  }

  .manifesto-label {
    color: var(--faint);
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .manifesto blockquote {
    margin: 0;
    font-size: clamp(1.7rem, 3.5vw, 3rem);
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.04em;
  }

  .manifesto-copy p {
    margin: 0 0 1.25rem;
    color: var(--muted);
  }

  @media (max-width: 960px) {
    .home-hero {
      grid-template-columns: 1fr;
      gap: 4rem;
      min-height: auto;
    }

    .hero-copy {
      max-width: 44rem;
    }

    .featured-wrap {
      min-height: auto;
    }

    .topic-grid,
    .manifesto {
      grid-template-columns: 1fr;
    }

    .manifesto {
      gap: 2rem;
    }
  }

  @media (max-width: 600px) {
    .home-hero {
      padding-block: 4rem;
    }

    .hero-copy h1 {
      font-size: clamp(2.6rem, 11.5vw, 3.2rem);
    }

    .featured-wrap {
      padding: 1rem;
    }

    .featured-card {
      min-height: 25rem;
    }

    .featured-footer {
      align-items: start;
      flex-direction: column;
    }

    .latest,
    .topic-section {
      padding-block: 4.5rem;
    }
  }
</style>
