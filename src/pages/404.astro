---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面未找到" description="你访问的页面不存在。">
  <section class="not-found page-width">
    <p class="error-code">404 / LOST NOTE</p>
    <h1>这一页还没有<br />写进笔记。</h1>
    <p>链接可能已经改变，或者这篇内容尚未发布。</p>
    <a class="button" href="/">返回首页</a>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    min-height: 70vh;
    padding-block: 6rem;
    align-items: start;
    justify-content: center;
    flex-direction: column;
  }

  .error-code {
    color: var(--accent);
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
  }

  .not-found h1 {
    margin: 0.5rem 0 1.2rem;
    font-size: clamp(3rem, 8vw, 6rem);
    line-height: 1;
    letter-spacing: -0.065em;
  }

  .not-found > p:not(.error-code) {
    color: var(--muted);
  }
</style>
