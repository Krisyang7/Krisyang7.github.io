---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../lib/posts';

const posts = await getPublishedPosts();
const tagCounts = new Map<string, number>();
posts.forEach((post) => post.data.tags.forEach((tag) => tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1)));
const tags = [...tagCounts.entries()].sort((a, b) => a[0].localeCompare(b[0], 'zh-CN'));
---

<BaseLayout title="标签" description="按主题浏览站内学习笔记。">
  <header class="page-hero page-width">
    <p class="eyebrow">Topic index</p>
    <h1>标签</h1>
    <p class="lead">从一个关键词出发，找到相关的笔记与方法。</p>
  </header>
  <section class="tag-cloud page-width" aria-label="全部标签">
    {tags.map(([tag, count]) => (
      <a href={`/tags/${encodeURIComponent(tag)}/`}>
        <strong>{tag}</strong>
        <span>{count} 条笔记</span>
      </a>
    ))}
  </section>
</BaseLayout>

<style>
  .tag-cloud {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 1rem;
  }

  .tag-cloud a {
    display: flex;
    min-height: 8rem;
    padding: 1.2rem;
    flex-direction: column;
    justify-content: space-between;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 0.55rem;
    text-decoration: none;
  }

  .tag-cloud a:hover {
    border-color: var(--accent);
  }

  .tag-cloud strong {
    font-size: 1.2rem;
  }

  .tag-cloud span {
    color: var(--faint);
    font-size: 0.8rem;
  }
</style>
