---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];

  return tags.map((tag) => ({
    params: { tag },
    props: { tag, posts: posts.filter((post) => post.data.tags.includes(tag)) },
  }));
}

interface Props {
  tag: string;
  posts: Post[];
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`标签：${tag}`} description={`浏览标签“${tag}”下的全部笔记。`}>
  <header class="page-hero page-width">
    <p class="eyebrow">Topic</p>
    <h1>#{tag}</h1>
    <p class="lead">共 {posts.length} 条笔记</p>
  </header>
  <section class="page-width" aria-label={`标签 ${tag} 的笔记`}>
    {posts.map((post, index) => <PostCard post={post} index={index} />)}
  </section>
</BaseLayout>
